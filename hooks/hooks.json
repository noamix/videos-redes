{
  "description": "Bloqueos de videos-redes: no deja mostrar, traer, pisar ni borrar el .env con las claves del sistema de videos ni sus respaldos, no deja borrar los volúmenes de Docker donde n8n guarda el flujo y las credenciales, y no deja que Claude corra los comandos que publican en las redes (eso lo hace el dueño).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*device_bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guardia.py\" pre-bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guardia.py\" pre-read",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guardia.py\" pre-write",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*device_stage_files",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guardia.py\" pre-stage",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*device_commit_files",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guardia.py\" pre-commit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
