# ===== Sistema de videos diarios: claves y ajustes técnicos =====
# Este archivo, copiado como .env, queda con permisos 600 y no se muestra, no se copia y no se sube.
#   Claves (secretas):  npm run cargar-clave -- NOMBRE                → las pide sin mostrarlas
#   Lo que no es secreto: npm run cargar-clave -- NOMBRE --valor "…"
#   Qué hay cargado:     npm run cargar-clave -- --lista
# Los datos del negocio (marca, web, hora, estilo, colores, WhatsApp, pausa) NO van acá: van en config/negocio.json.
# Después de cambiar este archivo: systemctl --user restart videos-redes   y   npm run chequeo

# --- Motor ---
MOTOR_PUERTO=8099
# Dónde escucha el motor. Con n8n en Docker: la IP del gateway de su red (ver n8n/docker-compose.yml), por ejemplo 172.31.250.1
MOTOR_HOST=127.0.0.1
# Clave que n8n manda en cada pedido (secreta): npm run cargar-clave -- MOTOR_CLAVE --generar
MOTOR_CLAVE=
# Cómo llega n8n al motor. Con n8n en Docker: http://IP-DEL-GATEWAY:8099
MOTOR_URL_PARA_N8N=

# --- Textos de cada video ---
# Gemini (gratis): aistudio.google.com/apikey → Create API key, sin activar la facturación (Billing).
# Sin clave, los textos salen de las plantillas de config/textos-plantillas.json (también gratis).
GEMINI_API_KEY=
# Si el modelo no anda, el motor prueba otros solo; el chequeo te dice cuál poner acá.
GEMINI_MODELO=gemini-3.5-flash
# auto = Gemini si hay clave (si falla, plantillas) · plantillas = nunca usar IA · gemini = solo Gemini
TEXTOS_MODO=auto

# --- Telegram: te llega cada video para aprobar o rehacer ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Planilla y n8n ---
# ID de la planilla: la parte larga de la URL  docs.google.com/spreadsheets/d/ESTE_ID/edit
PLANILLA_ID=
# Webhook de n8n para los botones de Telegram (n8n publicado en esta PC en el puerto 5678)
N8N_WEBHOOK_RESPUESTAS=http://127.0.0.1:5678/webhook/videos-redes-respuesta
# Opcional: ID de la credencial de Google Sheets en n8n (se ve en la URL al abrirla): el flujo se importa con ella elegida.
N8N_GOOGLE_CRED_ID=
N8N_GOOGLE_CRED_NOMBRE=Google Sheets account

# --- Instagram: lo carga npm run ig-conectar (por la página de Facebook vinculada; el video se sube directo a Meta) ---
IG_USER_ID=
IG_TOKEN=
IG_API_BASE=https://graph.facebook.com
IG_API_VERSION=v25.0
# Solo si tu usuario maneja varias cuentas (si no, sale de config/negocio.json)
IG_CUENTA=

# --- TikTok y YouTube Shorts por Buffer (plan gratis): publican el mismo video de Instagram ---
# Clave de publish.buffer.com/settings/api. Una sola para todas las redes.
BUFFER_API_KEY=
# Redes a usar (vacío = todas las conectadas en Buffer). Ejemplo: tiktok,youtube
BUFFER_REDES=
# TikTok: solo si hay más de una cuenta conectada en Buffer, su nombre.
BUFFER_TIKTOK=
# YouTube: obligatorio para publicar Shorts. El nombre del canal tal como lo muestra el chequeo.
BUFFER_YOUTUBE=
# Categoría de YouTube (22 = Gente y blogs, 26 = Consejos y estilo, 27 = Educación).
BUFFER_YOUTUBE_CATEGORIA=22

# --- WordPress (opcional): solo de respaldo, si Buffer no puede bajar el video de Instagram ---
WP_URL=
WP_USUARIO=
WP_CLAVE_APLICACION=
WP_BORRAR_DESPUES=si

# --- Render ---
# Si HyperFrames no encuentra Chrome, la ruta (por ejemplo /usr/bin/google-chrome)
HYPERFRAMES_BROWSER_PATH=
RENDER_CALIDAD=looks
DIAS_GUARDAR=60
