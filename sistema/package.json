{
  "name": "videos-redes-sistema",
  "version": "2.1.0",
  "description": "Videos diarios de productos para Instagram, TikTok y YouTube Shorts: planilla + n8n + HyperFrames + Gemini + Telegram + Buffer, con voz en off opcional (VoxCPM2)",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node motor/servidor.mjs",
    "chequeo": "node motor/chequeo.mjs",
    "prueba": "node motor/prueba.mjs",
    "n8n": "node motor/armar-n8n.mjs",
    "ig-conectar": "node motor/ig-conectar.mjs",
    "ig-probar": "node motor/ig-probar.mjs",
    "redes-probar": "node motor/redes-probar.mjs",
    "cargar-clave": "node motor/cargar-clave.mjs",
    "respaldo": "node motor/respaldo.mjs",
    "pruebas": "node pruebas/pruebas.mjs",
    "pruebas-voz": "python3 voz/pruebas_voz.py",
    "chrome-probar": "node motor/chrome-probar.mjs",
    "voz-evaluar": "python3 voz/evaluar.py",
    "voz-instalar": "bash voz/instalar.sh",
    "voz-preparar": "bash voz/correr.sh preparar_voz.py",
    "voz-medir": "python3 voz/evaluar.py --medir",
    "voz-probar": "bash voz/correr.sh voz_videos.py --legible --probar",
    "voz-estado": "bash voz/correr.sh voz_videos.py --estado --legible",
    "voz-desinstalar": "bash voz/desinstalar.sh",
    "vista-previa": "cd plantilla-cajas && HYPERFRAMES_NO_TELEMETRY=1 npx hyperframes preview",
    "vista-previa-clasico": "cd plantilla && HYPERFRAMES_NO_TELEMETRY=1 npx hyperframes preview"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "hyperframes": "0.9.41"
  }
}
